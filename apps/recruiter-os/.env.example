# ---------------------------------------------------------------------------
# RecruiterOS environment configuration
#
# Copy to .env and fill in. NEVER commit a filled-in .env.
# `pnpm config:check` validates a production configuration and refuses to
# start with unsafe combinations (see scripts/check-production-config.ts).
# ---------------------------------------------------------------------------

# --- Application mode ------------------------------------------------------
# DEMO  : isolated fictional data, deterministic local brief preparation,
#         simulated telecom, local email capture. Real DB, real queue, real
#         state machines. Outbound messaging and external AI are hard-blocked.
# LIVE  : provider adapters are used, but only after per-organization
#         enablement AND verified credentials. Missing config yields an
#         explicit blocked state, never a simulated success.
APP_MODE=DEMO

# Set to true ONLY on an isolated local/test deployment. Enables demo sign-in
# shortcuts, the demo event console and the demo dataset reset. Must be false
# whenever APP_MODE=LIVE.
DEMO_TOOLS_ENABLED=true

# Freeze/offset "now" for demonstrations and deterministic tests.
# Unset = real clock. ISO instant = fixed clock. "+3d"/"-2h" = offset.
DEMO_CLOCK=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruiteros?schema=public
# Used by the Vitest integration suite. MUST be a throwaway database: the
# suite truncates it.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruiteros_test?schema=public
# Used only by `pnpm db:check`, which replays the committed migrations into a
# throwaway database to prove they still produce exactly prisma/schema.prisma.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruiteros_shadow?schema=public

# --- Authentication (Better Auth) ------------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Externally reachable origin. Used for cookies, callbacks and webhook URL
# reconstruction. Behind a proxy this must be the PUBLIC origin, not the
# internal one.
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated additional trusted origins for CSRF/origin checks.
TRUSTED_ORIGINS=
# Set to true only when running behind a proxy you control that sets
# X-Forwarded-* headers. See DEPLOYMENT.md.
TRUST_PROXY_HEADERS=false

# --- Outbound email (invitations, password resets) -------------------------
# Local development captures mail in Mailpit (http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RecruiterOS <no-reply@recruiteros.invalid>"

# --- Worker ----------------------------------------------------------------
# pg-boss shares DATABASE_URL by default; override to point at a replica/role.
WORKER_DATABASE_URL=
WORKER_PORT=3001
WORKER_CONCURRENCY=4

# --- Twilio (SMS + Voice) --------------------------------------------------
# Leave empty to keep the Twilio adapter unavailable. Per-organization
# enablement is ALSO required (Settings -> Integrations).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The externally configured webhook base URL Twilio signs against. If your
# app sits behind a proxy that rewrites the URL, set this to what you typed
# into the Twilio console, or signature validation will fail.
TWILIO_WEBHOOK_BASE_URL=

# --- Anthropic (optional AI brief preparation) -----------------------------
# Leave empty to keep brief preparation on the deterministic local adapter.
ANTHROPIC_API_KEY=
# Model id is configuration, never hardcoded. Example: claude-sonnet-5
ANTHROPIC_MODEL=

# --- Outbound webhook handoff ---------------------------------------------
# Comma-separated https origins allowed as webhook destinations. Empty
# disables the outbound webhook adapter entirely.
OUTBOUND_WEBHOOK_ALLOWED_ORIGINS=
OUTBOUND_WEBHOOK_SIGNING_SECRET=

# --- Operational -----------------------------------------------------------
LOG_LEVEL=info
