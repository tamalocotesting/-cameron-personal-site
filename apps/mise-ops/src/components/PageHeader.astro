---
/** The opening band every interior page shares. */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-head">
  <div class="shell shell--wide">
    <span class="tape">{eyebrow}</span>
    <h1>{title}</h1>
    {lede && <p class="lede page-head__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 1.8rem + 3vw, 4.5rem) var(--section-y);
    border-bottom: 1px solid var(--rule);
  }

  .page-head .shell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
  }

  .page-head h1 {
    font-size: clamp(2.1rem, 1.4rem + 3vw, 3.5rem);
    max-width: 18ch;
  }

  .page-head__lede {
    max-width: 52ch;
  }
</style>
