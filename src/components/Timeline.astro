---
import { timeline } from '../data/career';
---

<ol class="tl">
  {
    timeline.map((role, i) => (
      <li class:list={['tl__row', { 'tl__row--key': role.key }]} data-reveal style={`--reveal-delay:${i * 45}ms`}>
        <span class="tl__years">
          {role.from}
          {role.to !== role.from && (
            <>
              <span class="tl__dash" aria-hidden="true">
                &ndash;
              </span>
              {role.to}
            </>
          )}
        </span>

        <span class="tl__role">
          <span class="tl__title">{role.title}</span>
          <span class="tl__org">
            {role.org}
            {role.where && <span class="tl__where">{role.where}</span>}
          </span>
        </span>

        {role.note && <span class="tl__note">{role.note}</span>}
      </li>
    ))
  }
</ol>

<style>
  .tl {
    border-top: 1px solid var(--rule);
    max-width: 58rem;
  }

  .tl__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-areas:
      'years role'
      '.     note';
    gap: 0.35rem 0.9rem;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 52em) {
    .tl__row {
      grid-template-columns: 6rem minmax(0, 15rem) minmax(0, 1fr);
      grid-template-areas: 'years role note';
      gap: var(--space-m);
      align-items: baseline;
      padding-block: var(--space-m);
    }
  }

  /* --- years -------------------------------------------------------- */
  .tl__years {
    grid-area: years;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .tl__dash {
    opacity: 0.55;
    padding-inline: 0.1em;
  }

  .tl__row--key .tl__years {
    color: var(--accent-ink);
  }

  /* --- role --------------------------------------------------------- */
  .tl__role {
    grid-area: role;
    display: block;
  }

  .tl__title {
    display: block;
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.016em;
    line-height: 1.22;
    color: var(--ink-2);
  }

  .tl__row--key .tl__title {
    font-size: var(--step-1);
    font-weight: 640;
    color: var(--ink);
  }

  .tl__org {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.35;
  }

  .tl__where::before {
    content: ' · ';
  }

  /* --- note --------------------------------------------------------- */
  .tl__note {
    grid-area: note;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 52ch;
  }

  /* Supporting roles sit back so the three that carry the story lead. */
  .tl__row:not(.tl__row--key) {
    padding-block: 0.65rem;
  }

  @media (min-width: 52em) {
    .tl__row:not(.tl__row--key) {
      padding-block: 0.7rem;
    }
  }
</style>
