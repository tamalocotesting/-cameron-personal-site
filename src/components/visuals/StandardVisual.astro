---
/**
 * Diagram: where operating knowledge lives before (scattered, perishable) and
 * after (structured, searchable). The thesis of Service & Standard in one image.
 */
const before = [
  'A binder nobody opens',
  'A PDF emailed in 2022',
  'The group chat',
  '“Ask Dave”',
  'Muscle memory',
];
const after = [
  { k: 'SOP', v: 'Written once, versioned' },
  { k: 'BUILD', v: 'Visual, step by step' },
  { k: 'TRAIN', v: 'Day-one usable' },
  { k: 'FIX', v: 'Troubleshooting paths' },
];
---

<div
  class="sv"
  role="img"
  aria-label="Diagram contrasting where operating knowledge lives before and after. Before: a binder nobody opens, a PDF emailed in 2022, the group chat, asking a colleague, and muscle memory. After: versioned SOPs, visual step-by-step builds, day-one training and troubleshooting paths."
>
  <div class="sv__side sv__side--before">
    <p class="sv__label">In people&rsquo;s heads</p>
    <ul class="sv__scatter">
      {before.map((b, i) => <li class="sv__frag" style={`--i:${i}`}>{b}</li>)}
    </ul>
  </div>

  <div class="sv__bridge" aria-hidden="true">
    <span class="sv__bridge-rule"></span>
    <span class="sv__bridge-word">CAPTURE</span>
    <span class="sv__bridge-rule"></span>
  </div>

  <div class="sv__side sv__side--after">
    <p class="sv__label">In a system</p>
    <ul class="sv__stack">
      {
        after.map((a) => (
          <li class="sv__slot">
            <span class="sv__slot-k">{a.k}</span>
            <span class="sv__slot-v">{a.v}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .sv {
    display: grid;
    gap: var(--space-s);
    padding: clamp(0.75rem, 0.4rem + 1.2vw, 1.5rem) var(--space-s);
    align-items: stretch;
  }

  .sv__side {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sv__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Before — deliberately loose and untidy. */
  .sv__scatter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-content: flex-start;
    flex: 1;
  }

  .sv__frag {
    font-size: 0.6875rem;
    color: var(--ink-3);
    padding: 0.28rem 0.5rem;
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius);
    line-height: 1.25;
    transform: rotate(calc((var(--i) - 2) * 0.6deg));
    background: var(--paper);
  }

  /* Bridge */
  .sv__bridge {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sv__bridge-rule {
    flex: 1;
    height: 1px;
    background: var(--rule-strong);
  }

  .sv__bridge-word {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    color: var(--accent-ink);
  }

  /* After — aligned, labelled, filed. */
  .sv__stack {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    flex: 1;
    align-content: start;
  }

  .sv__slot {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.5rem 0.6rem;
    background: var(--paper-raised);
  }

  .sv__slot-k {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--accent-ink);
    width: 2.9rem;
    flex: none;
  }

  .sv__slot-v {
    font-size: 0.6875rem;
    color: var(--ink);
    line-height: 1.3;
  }

  @media (min-width: 30em) {
    .sv {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-m);
    }

    .sv__bridge {
      flex-direction: column;
      padding-top: 1.35rem;
    }

    .sv__bridge-rule {
      width: 1px;
      height: auto;
      flex: 1;
    }

    .sv__bridge-word {
      writing-mode: vertical-rl;
      letter-spacing: 0.2em;
    }
  }
</style>
