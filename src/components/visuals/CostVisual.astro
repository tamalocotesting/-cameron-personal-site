---
/**
 * Interface sketch: invoice lines extracted, matched to catalog products, and
 * scored — with anything uncertain routed to a human. The review path is the
 * point of the drawing.
 */
const rows = [
  {
    raw: 'EGG LRG GR-A 15DZ',
    match: 'Eggs, large, Grade A — 15 doz case',
    score: 98,
    state: 'auto',
    delta: '+2.1%',
  },
  {
    raw: 'CRM CHS PLN 3/5LB',
    match: 'Cream cheese, plain — 3 × 5 lb',
    score: 96,
    state: 'auto',
    delta: '+8.4%',
  },
  {
    raw: 'SESAME SD NAT BULK',
    match: 'Sesame seed, natural — bulk?',
    score: 61,
    state: 'review',
    delta: '—',
  },
];
---

<div
  class="cv"
  role="img"
  aria-label="Sketch of an invoice review screen: three extracted invoice lines matched to catalogue products with confidence scores of 98, 96 and 61 percent. The two high-confidence lines post automatically and show unit-cost changes of plus 2.1 and plus 8.4 percent; the 61 percent line is held for human review."
>
  <div class="cv__panel">
    <div class="cv__head">
      <span class="cv__doc">INVOICE 44182</span>
      <span class="cv__sep" aria-hidden="true"></span>
      <span class="cv__doc cv__doc--dim">3 LINES READ</span>
    </div>

    <ul class="cv__rows">
      {
        rows.map((r) => (
          <li class:list={['cv__row', { 'cv__row--review': r.state === 'review' }]}>
            <div class="cv__raw">{r.raw}</div>
            <div class="cv__arrow" aria-hidden="true">
              &rarr;
            </div>
            <div class="cv__match">
              <span class="cv__match-name">{r.match}</span>
              <span class="cv__meter" aria-hidden="true">
                <span class="cv__meter-fill" style={`--score:${r.score}%`} />
              </span>
            </div>
            <div class="cv__score">
              <span class="cv__pct">{r.score}%</span>
              <span class:list={['cv__flag', r.state === 'review' ? 'cv__flag--review' : 'cv__flag--auto']}>
                {r.state === 'review' ? 'REVIEW' : 'AUTO'}
              </span>
            </div>
            <div class:list={['cv__delta', { 'cv__delta--up': r.delta.startsWith('+') }]}>{r.delta}</div>
          </li>
        ))
      }
    </ul>

    <div class="cv__foot">
      <span class="cv__foot-label">HELD FOR A HUMAN</span>
      <span class="cv__foot-val">1 of 3</span>
    </div>
  </div>
</div>

<style>
  .cv {
    padding: clamp(0.75rem, 0.4rem + 1.2vw, 1.5rem) var(--space-s);
  }

  .cv__panel {
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .cv__head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .cv__doc {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.13em;
    color: var(--ink-2);
  }

  .cv__doc--dim {
    color: var(--ink-3);
  }

  .cv__sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ink-3);
    opacity: 0.6;
  }

  .cv__row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'raw    delta'
      'match  score';
    gap: 0.3rem 0.55rem;
    align-items: center;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .cv__rows > li:last-child {
    border-bottom: 0;
  }

  .cv__row--review {
    background: var(--accent-wash);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .cv__raw {
    grid-area: raw;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cv__arrow {
    display: none;
    color: var(--ink-3);
    font-size: 0.7rem;
  }

  .cv__match {
    grid-area: match;
    min-width: 0;
  }

  .cv__match-name {
    display: block;
    font-size: 0.6875rem;
    color: var(--ink);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .cv__meter {
    display: block;
    height: 2px;
    margin-top: 0.3rem;
    background: var(--rule);
    border-radius: 2px;
    overflow: hidden;
    max-width: 8rem;
  }

  .cv__meter-fill {
    display: block;
    height: 100%;
    width: var(--score);
    background: var(--accent);
    opacity: 0.75;
  }

  .cv__score {
    grid-area: score;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: end;
  }

  .cv__pct {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
  }

  .cv__flag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    padding: 0.16rem 0.3rem;
    border-radius: 2px;
    border: 1px solid currentColor;
    line-height: 1;
  }

  .cv__flag--auto {
    color: var(--ink-3);
  }

  .cv__flag--review {
    color: var(--accent-ink);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .cv__delta {
    grid-area: delta;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  .cv__delta--up {
    color: var(--accent-ink);
    font-weight: 500;
  }

  .cv__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.75rem;
    border-top: 1px solid var(--rule-strong);
    background: var(--paper-sunken);
  }

  .cv__foot-label,
  .cv__foot-val {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.13em;
    color: var(--ink-3);
  }

  .cv__foot-val {
    color: var(--accent-ink);
    font-weight: 500;
  }

  /* Wider cards get the full raw → match → score row on one line. */
  @media (min-width: 26em) {
    .cv__row {
      grid-template-columns: minmax(0, 8.5rem) auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'raw arrow match score delta';
      gap: 0.6rem;
    }

    .cv__arrow {
      display: block;
      grid-area: arrow;
    }

    .cv__meter {
      max-width: 100%;
    }
  }
</style>
