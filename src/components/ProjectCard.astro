---
import Badge from './Badge.astro';
import SpecList from './SpecList.astro';
import ProjectVisual from './ProjectVisual.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Flips the visual to the other side so a stack of cards has a rhythm. */
  flip?: boolean;
}
const { project, flip = false } = Astro.props;
---

<article class:list={['card', { 'card--flip': flip }]} data-reveal>
  <div class="card__head">
    <div class="card__top">
      <span class="card__index">{project.index}</span>
      <Badge stage={project.stage} />
    </div>

    <h3 class="card__title">
      <a href={project.href} class="card__link">{project.title}</a>
    </h3>

    <p class="card__tagline">{project.tagline}</p>
  </div>

  <div class="card__visual">
    <ProjectVisual visual={project.visual} />
  </div>

  <div class="card__body">
    <p class="card__summary">{project.summary}</p>

    <SpecList items={project.spec} class="card__spec" />

    <span class="card__cta">
      Read the case study
      <span class="card__arrow" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease-out);
  }

  @media (min-width: 40em) {
    .card {
      padding: var(--space-l);
    }
  }

  /* Wide: the sketch takes its own column and the copy reads straight down.
     Narrow: the sketch slots in after the title, where it explains the most. */
  @media (min-width: 60em) {
    .card {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
      grid-template-areas:
        'head visual'
        'body visual';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-xl);
      row-gap: var(--space-s);
      align-items: start;
      padding: var(--space-xl);
    }

    .card--flip {
      grid-template-areas:
        'visual head'
        'visual body';
    }

    .card__head {
      grid-area: head;
    }
    .card__visual {
      grid-area: visual;
      align-self: center;
    }
    .card__body {
      grid-area: body;
    }
  }

  /* Hover is a desktop affordance; on touch it would flash on every tap. */
  @media (hover: hover) {
    .card:hover {
      border-color: var(--rule-strong);
      box-shadow: var(--shadow-lift);
      transform: translateY(-2px);
    }
  }

  .card:focus-within {
    border-color: var(--accent);
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-s);
  }

  .card__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .card__title {
    font-size: var(--step-3);
    letter-spacing: -0.026em;
    line-height: 1.04;
  }

  .card__link {
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }

  /* Whole card is the tap target — matters most on a phone. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  @media (hover: hover) {
    .card:hover .card__link {
      background-size: 100% 2px;
    }
  }

  .card__tagline {
    margin-top: 0.6rem;
    margin-bottom: 0.4rem;
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.34;
    color: var(--ink);
    max-width: 34ch;
    text-wrap: pretty;
  }

  .card__summary {
    margin-top: 0;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .card__spec {
    margin-top: var(--space-s);
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-top: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .card__arrow {
    transition: transform 0.28s var(--ease-out);
  }

  @media (hover: hover) {
    .card:hover .card__arrow {
      transform: translateX(4px);
    }
  }

  /* The card is one big link, but the visual column can hold a real input —
     so it sits above the stretched hit area and stays usable. */
  .card__visual {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
</style>
