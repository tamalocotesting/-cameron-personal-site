---
import Base from '../layouts/Base.astro';
import WorkEntry from '../components/work/WorkEntry.astro';
import Badge from '../components/Badge.astro';
import { projects, exploration, stageMeta } from '../data/projects';
import { site, mailto } from '../data/site';
import Timeline from '../components/Timeline.astro';

const path = [
  {
    n: '01',
    title: 'Work the operation',
    body: 'Prep, production, food cost, labour, training. You learn which things break, how often, and always at the worst possible moment.',
  },
  {
    n: '02',
    title: 'Write it down',
    body: 'The recipe three people make three ways. The close nobody does twice the same. Documentation is the cheapest fix in the building, and almost nobody does it.',
  },
  {
    n: '03',
    title: 'Fix the process first',
    body: 'Most problems people call software problems are sequencing problems. Change the order of the work before you build anything.',
  },
  {
    n: '04',
    title: 'Then build the tool',
    body: 'When the process is right and it still doesn’t stick, the problem is access. Put it on the phone that is already in their pocket.',
  },
  {
    n: '05',
    title: 'Use AI where it earns it',
    body: 'Reading invoices, matching products, drafting procedures. Then spend most of the effort on the part that matters: catching it when it’s wrong.',
  },
];

const questions = [
  'What does someone need to know at 7:15 on a Saturday, and how many taps until they have it?',
  'What happens the week the person who knows everything is out?',
  'Which step in this process reliably produces the same mistake?',
  'What should the software decide on its own, and where does a human have to stay in it?',
  'How do we find out the model got it wrong before it costs money?',
];

const opsSkills = [
  'Process mapping and SOP writing',
  'Recipes, menu builds and food cost',
  'Prep and production systems',
  'Training and new-hire onboarding',
  'Multilingual floor documentation',
  'Rollout, adoption and retraining',
];

const buildSkills = [
  'Mobile-first internal tools',
  'AI extraction and matching workflows',
  'Confidence, review queues, human-in-the-loop',
  'Data models for messy real-world records',
  'Search and information architecture',
  'Prototyping, then implementing for real users',
];
---

<Base
  title="Cameron Macek — operations, AI implementation, internal tools"
  description={site.description}
  suffix={false}
>
  <!-- ══════════════════════════════════════════════════════════ HERO ══ -->
  <section class="hero">
    <div class="shell">
      <p class="hero__kicker">
        <span class="kicker">Implementation &middot; operations &middot; training</span>
        <span class="hero__place">{site.location}</span>
      </p>

      <h1 class="hero__title">
        Before it was called implementation,
        <span class="hero__title-2">it was called opening a restaurant.</span>
      </h1>

      <div class="hero__grid">
        <div class="hero__say">
          <p class="hero__lede">
            Ten years getting teams to standard &mdash; new-location openings, back of house,
            customer-facing retail. Now I build the internal tools and AI workflows that do the same
            job, and I still work the floor they&rsquo;re built for.
          </p>

          <div class="hero__actions">
            <a class="btn btn--primary" href="#work">
              See the work <span class="btn__arrow" aria-hidden="true">&darr;</span>
            </a>
            <a class="btn btn--ghost" href="/resume.pdf" download>
              Résumé <span class="btn__arrow" aria-hidden="true">&darr;</span>
            </a>
          </div>
        </div>

        <!-- The dupe: what a kitchen hands you, holding what a recruiter needs. -->
        <dl class="ticket">
          <p class="ticket__head" aria-hidden="true">
            <span>STATION</span><span>CAMERON M.</span>
          </p>
          <div class="ticket__row">
            <dt>Now</dt>
            <dd>Back-of-House Manager, B&rsquo;s Bagels &mdash; Westfield, Indiana</dd>
          </div>
          <div class="ticket__row">
            <dt>Before</dt>
            <dd>New-location opening trainer at Cooper&rsquo;s Hawk &middot; retail sales at AT&amp;T</dd>
          </div>
          <div class="ticket__row">
            <dt>Open to</dt>
            <dd>Implementation, customer onboarding, solutions and product operations</dd>
          </div>
          <p class="ticket__foot" aria-hidden="true">— FIRED —</p>
        </dl>
      </div>
    </div>

    <div class="shell"><div class="ticks" aria-hidden="true"></div></div>
  </section>

  <!-- ═════════════════════════════════════════════════ TRACK RECORD ══ -->
  <section class="section rec" id="approach">
    <div class="shell">
      <div class="rec__top">
        <span class="numeral rec__numeral" aria-hidden="true">01</span>
        <div class="rec__intro">
          <p class="kicker">Track record</p>
          <h2 class="rec__title">Implementation, before it had that name.</h2>
          <div class="prose rec__prose">
            <p>
              Opening a restaurant is an implementation project. You arrive somewhere that
              isn&rsquo;t running, with a team that has never done the job, against a date that
              doesn&rsquo;t move. You set up the stations, train the people, get them to standard,
              and leave it working without you.
            </p>
            <p>
              I did that for two years at Cooper&rsquo;s Hawk before I wrote a line of software. Two
              years before that I was at AT&amp;T explaining technology to people who didn&rsquo;t
              care how it worked, only whether it solved their problem. Ten years of it, and none of
              it was called implementation.
            </p>
          </div>
        </div>
      </div>

      <Timeline />
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════ METHOD ══ -->
  <section class="section section--sunken method">
    <div class="shell">
      <div class="method__head">
        <p class="kicker">The method</p>
        <h2 class="method__title">
          Doing that long enough <span>gives you an order of operations.</span>
        </h2>
        <p class="method__sub">It is the same one I use on software now.</p>
      </div>

      <ol class="method__list">
        {
          path.map((step, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${i * 55}ms`}>
              <span class="numeral step__n" aria-hidden="true">
                {step.n}
              </span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════ SELECTED WORK ══ -->
  <section class="section work" id="work">
    <div class="shell">
      <div class="work__head">
        <div>
          <p class="kicker">Selected work</p>
          <h2 class="work__title">Four problems I couldn&rsquo;t stop looking at.</h2>
        </div>

        <div class="work__legend">
          <p class="work__legend-intro">
            Each one is labelled with where it honestly stands. I&rsquo;d rather be believable than
            impressive.
          </p>
          <ul class="work__legend-list">
            {
              (Object.keys(stageMeta) as (keyof typeof stageMeta)[]).map((key) => (
                <li class="work__legend-item">
                  <Badge stage={key} />
                  <span class="work__legend-note">{stageMeta[key].note}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="work__list">
        <WorkEntry project={projects[0]} layout="lead" />
        <WorkEntry project={projects[1]} layout="tool" />
        <WorkEntry project={projects[2]} layout="document" />
        <WorkEntry project={projects[3]} layout="statement" />
      </div>

      <div class="work__also" data-reveal>
        <h3 class="work__also-title label">Also explored</h3>
        <div class="work__also-item">
          <div class="work__also-head">
            <h4 class="work__also-name">{exploration.title}</h4>
            <Badge stage={exploration.stage} />
          </div>
          <p class="work__also-body">{exploration.body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ QUESTIONS — INVERTED ══ -->
  <section class="band questions" id="questions">
    <div class="shell">
      <div class="questions__head">
        <p class="kicker">How I think</p>
        <h2 class="questions__title">
          Every system I build is an answer to one of these.
        </h2>
        <p class="questions__sub">
          They are operational questions before they are technical ones. If you can&rsquo;t answer
          them about a process, software will only make the confusion faster.
        </p>
      </div>

      <ol class="questions__list">
        {
          questions.map((question, i) => (
            <li class="q" data-reveal style={`--reveal-delay:${i * 50}ms`}>
              <span class="q__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="q__text">{question}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════ CAPABILITY ══ -->
  <section class="section cap">
    <div class="shell">
      <div class="cap__head">
        <div>
          <p class="kicker">What I do</p>
          <h2 class="cap__title">Two halves of the same job.</h2>
        </div>
        <p class="cap__intro">
          The useful thing isn&rsquo;t either column on its own. It&rsquo;s being able to sit in a
          walk-in counting cases in the morning and design the data model for it that afternoon.
        </p>
      </div>

      <div class="cap__grid">
        <div class="cap__col" data-reveal>
          <h3 class="cap__col-title">
            <span class="cap__col-n">A</span> From the operations side
          </h3>
          <ul class="cap__list">
            {opsSkills.map((skill) => <li class="cap__item">{skill}</li>)}
          </ul>
        </div>

        <div class="cap__col" data-reveal style="--reveal-delay:80ms">
          <h3 class="cap__col-title">
            <span class="cap__col-n">B</span> From the building side
          </h3>
          <ul class="cap__list">
            {buildSkills.map((skill) => <li class="cap__item">{skill}</li>)}
          </ul>
        </div>
      </div>

      <aside class="cap__honest" data-reveal>
        <p class="label">Where I&rsquo;m not your person</p>
        <p class="cap__honest-body">
          Distributed systems, infrastructure, ML research, or anything that needs a career backend
          engineer. I&rsquo;m not going to pretend otherwise. I work in the layer where the business
          meets the software &mdash; understanding the operation, designing the workflow, building
          the thing people actually touch, and getting it adopted.
        </p>
      </aside>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════ CONTACT ══ -->
  <section class="section contact" id="contact">
    <div class="shell">
      <div class="shell"><div class="ticks contact__ticks" aria-hidden="true"></div></div>

      <p class="kicker contact__kicker">What&rsquo;s next</p>

      <h2 class="contact__title">
        I&rsquo;m looking for work where understanding the customer&rsquo;s business
        <span>is the hard part.</span>
      </h2>

      <div class="contact__grid">
        <div class="prose contact__body">
          <p>
            AI implementation, solutions and implementation work, product operations, operations
            technology. Restaurant and hospitality software especially &mdash; but the pattern
            travels. Any business where the real process lives in people&rsquo;s heads and the
            software has to meet it there.
          </p>
          <p>
            If you&rsquo;re building something and the hard part is getting it to survive contact
            with a real operation, that&rsquo;s the part I&rsquo;m good at. And if you run a
            restaurant or a service business drowning in its own undocumented knowledge, that
            conversation is open too.
          </p>

          <div class="contact__actions">
            <a class="btn btn--primary" href={mailto('Hello Cameron')}>
              Email me <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="btn btn--ghost" href="/resume">Full background</a>
          </div>
        </div>

        <aside class="contact__aside">
          <p class="label">Worth knowing</p>
          <ul class="contact__facts">
            <li>Based in Carmel, Indiana. Comfortable remote, happy to travel for implementation work.</li>
            <li>
              I&rsquo;ll ask about your customers&rsquo; actual day before I ask about your stack.
            </li>
            <li>No agency, no team, no retainer. Just me, so far.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ═══════════════════════════════════════════════════════════ HERO ══ */
  @media (prefers-reduced-motion: no-preference) {
    .hero__kicker,
    .hero__title,
    .hero__title-2,
    .hero__say,
    .ticket {
      animation: hero-rise 0.62s var(--ease-out) both;
    }
    .hero__kicker {
      animation-delay: 0.04s;
    }
    .hero__title {
      animation-delay: 0.1s;
    }
    .hero__title-2 {
      animation-delay: 0.2s;
    }
    .hero__say {
      animation-delay: 0.28s;
    }
    .ticket {
      animation-delay: 0.36s;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .hero {
    position: relative;
    z-index: 1;
    padding-top: clamp(1.75rem, 0.8rem + 4vw, 4rem);
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(1.25rem, 0.6rem + 2.4vw, 2.5rem);
  }

  .hero__place {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* The scale jump is the point: this is the largest thing on the site. */
  .hero__title {
    font-size: var(--step-6);
    line-height: 0.92;
    letter-spacing: -0.042em;
    max-width: 15ch;
    /* "implementation," is longer than a 320px screen at display size.
       Hyphenate rather than let one word set the page width. */
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .hero__title-2 {
    display: block;
    margin-top: 0.14em;
    font-size: 0.56em;
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 560;
    color: var(--ink-3);
    max-width: 24ch;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    margin-top: clamp(1.75rem, 1rem + 3vw, 3.25rem);
  }

  @media (min-width: 60em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--space-2xl);
      align-items: start;
    }

    /* The dupe hangs a little higher than the column it sits beside, so the
       two halves of the hero interlock rather than sitting on a shelf. */
    .ticket {
      margin-top: -0.4rem;
    }
  }

  .hero__lede {
    max-width: 44ch;
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }

  /* --- the dupe ---------------------------------------------------- */
  .ticket {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-top: 0;
    padding: 0 0 0.9rem;
    box-shadow: var(--shadow-card);
  }

  /* Perforated top edge, the way a ticket tears off the printer. */
  .ticket::before {
    content: '';
    position: absolute;
    inset: -7px 0 auto 0;
    height: 8px;
    background: var(--paper-raised);
    border-inline: 1px solid var(--rule-strong);
    mask-image: radial-gradient(circle 5px at 7px 0, transparent 98%, #000 100%);
    mask-size: 14px 8px;
    mask-repeat: repeat-x;
    -webkit-mask-image: radial-gradient(circle 5px at 7px 0, transparent 98%, #000 100%);
    -webkit-mask-size: 14px 8px;
    -webkit-mask-repeat: repeat-x;
  }

  .ticket__head,
  .ticket__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    color: var(--ink-3);
    border-bottom: 1px dashed var(--rule-strong);
  }

  .ticket__foot {
    justify-content: center;
    border-bottom: 0;
    border-top: 1px dashed var(--rule-strong);
    padding-bottom: 0;
    padding-top: 0.75rem;
    color: var(--accent-ink);
  }

  .ticket__row {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.9rem;
  }

  .ticket__row + .ticket__row {
    border-top: 1px solid var(--rule);
  }

  .ticket__row dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ticket__row dd {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink);
  }

  .hero .ticks {
    margin-top: clamp(2rem, 1rem + 4vw, 4rem);
  }

  /* ═════════════════════════════════════════════════════ TRACK RECORD ══ */
  .rec__top {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 62em) {
    .rec__top {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }

    /* The numeral leans into the gutter — a page number, not a label. */
    .rec__numeral {
      margin-left: -0.06em;
    }
  }

  .rec__numeral {
    display: block;
    font-size: var(--step-6);
  }

  @media (min-width: 62em) {
    .rec__numeral {
      font-size: var(--step-7);
      margin-top: -0.06em;
    }
  }

  .rec__title {
    margin-top: var(--space-s);
    font-size: var(--step-4);
    letter-spacing: -0.033em;
    max-width: 16ch;
  }

  .rec__prose {
    margin-top: var(--space-m);
    font-size: var(--step-0);
    max-width: 62ch;
  }

  .rec__prose p + p {
    margin-top: 0.9em;
  }

  @media (min-width: 78em) {
    /* Statement left, argument right — two voices instead of one column. */
    .rec__intro {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .rec__intro > .kicker {
      grid-column: 1 / -1;
    }

    .rec__title {
      margin-top: var(--space-m);
    }

    .rec__prose {
      margin-top: var(--space-m);
    }
  }

  /* ═════════════════════════════════════════════════════════ METHOD ══ */
  .method__head {
    max-width: 46rem;
    margin-bottom: var(--space-xl);
  }

  .method__title {
    margin-top: var(--space-s);
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    max-width: 20ch;
  }

  .method__title span {
    color: var(--ink-3);
  }

  .method__sub {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 48ch;
  }

  .method__list {
    display: grid;
    border-top: 1px solid var(--rule);
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }

  .step__n {
    font-size: var(--step-5);
    line-height: 0.8;
    display: block;
  }

  .step__title {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.16;
  }

  .step__text {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 56ch;
  }

  @media (min-width: 52em) {
    .step {
      grid-template-columns: minmax(0, 7rem) minmax(0, 14rem) minmax(0, 1fr);
      gap: var(--space-l);
      padding-block: var(--space-l);
      align-items: baseline;
    }

    .step__n {
      font-size: var(--step-6);
    }

    .step__body {
      display: contents;
    }

    .step__text {
      margin-top: 0;
    }
  }

  /* The numerals grow as the method moves from watching to building. */
  @media (min-width: 62em) {
    .step:nth-child(1) .step__n {
      opacity: 0.55;
    }
    .step:nth-child(2) .step__n {
      opacity: 0.7;
    }
    .step:nth-child(3) .step__n {
      opacity: 0.85;
    }
    .step:nth-child(5) .step__n {
      color: var(--accent);
      -webkit-text-stroke: 0;
    }
  }

  /* ═══════════════════════════════════════════════════════════ WORK ══ */
  .work__head {
    display: grid;
    gap: var(--space-l);
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 52em) {
    .work__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: end;
    }
  }

  .work__title {
    margin-top: var(--space-s);
    font-size: var(--step-4);
    max-width: 14ch;
    letter-spacing: -0.033em;
  }

  .work__legend-intro {
    font-size: var(--step--1);
    color: var(--ink-2);
    max-width: 46ch;
    margin-bottom: var(--space-s);
  }

  .work__legend-list {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.55rem 0.7rem;
    align-items: start;
  }

  .work__legend-item {
    display: contents;
  }

  .work__legend-list :global(.badge) {
    justify-self: start;
  }

  .work__legend-note {
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.45;
  }

  .work__list {
    display: grid;
    gap: var(--space-3xl);
  }

  .work__also {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-3xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule-strong);
  }

  @media (min-width: 44em) {
    .work__also {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-l);
      align-items: baseline;
    }
  }

  .work__also-title {
    margin: 0;
  }

  .work__also-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: 0.5rem;
  }

  .work__also-name {
    font-size: var(--step-1);
    letter-spacing: -0.018em;
  }

  .work__also-body {
