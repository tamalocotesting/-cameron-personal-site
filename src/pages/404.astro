---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base
  title="Page not found"
  description="That page doesn't exist. Here's what does."
>
  <section class="nf">
    <div class="shell shell--narrow">
      <p class="label">Error 404</p>
      <h1 class="nf__title">That page isn&rsquo;t here.</h1>
      <p class="nf__body">
        Either it moved or it never existed. Both are documentation failures, which is a little
        embarrassing given the rest of this site. Here&rsquo;s what does exist:
      </p>

      <ul class="nf__list">
        <li class="nf__item">
          <a href="/">Home</a>
          <span>The short version of who I am</span>
        </li>
        {
          projects.map((p) => (
            <li class="nf__item">
              <a href={p.href}>{p.title}</a>
              <span>{p.tagline}</span>
            </li>
          ))
        }
        <li class="nf__item">
          <a href="/background">Background</a>
          <span>How operations turned into building software</span>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(3rem, 1.5rem + 7vw, 6rem) var(--space-2xl);
  }

  .nf__title {
    margin-top: var(--space-m);
    font-size: var(--step-4);
    letter-spacing: -0.033em;
  }

  .nf__body {
    margin-top: var(--space-s);
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 50ch;
  }

  .nf__list {
    margin-top: var(--space-xl);
    border-top: 1px solid var(--rule);
  }

  .nf__item {
    display: grid;
    gap: 0.15rem;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 40em) {
    .nf__item {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: var(--space-m);
      align-items: baseline;
    }
  }

  .nf__item a {
    font-size: var(--step-0);
    font-weight: 620;
    letter-spacing: -0.014em;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.18s var(--ease);
  }

  .nf__item a:hover {
    color: var(--accent-ink);
  }

  .nf__item span {
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.5;
  }
</style>
