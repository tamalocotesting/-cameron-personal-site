---
import '../styles/prose.css';
import Base from './Base.astro';
import Badge from '../components/Badge.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { projects, getProject } from '../data/projects';
import { mailto } from '../data/site';

interface Props {
  slug: string;
  /** Entries for the contents rail. Ids must match the <section> ids. */
  sections?: { id: string; label: string }[];
}
const { slug, sections = [] } = Astro.props;
const project = getProject(slug);

const i = projects.findIndex((p) => p.slug === slug);
const next = projects[(i + 1) % projects.length];
---

<Base
  title={project.seoTitle}
  description={project.seoDescription}
  ogType="article"
  ogImage={`/og-${project.slug}.png`}
>
  <article class="case">
    <header class="case__header">
      <div class="shell">
        <div class="case__bar">
          <a href="/#work" class="case__back">
            <span aria-hidden="true">&larr;</span> Selected work
          </a>
          <Badge stage={project.stage} />
        </div>

        <div class="case__title-block">
          <span class="numeral case__index" aria-hidden="true">{project.index}</span>
          <h1 class="case__title">{project.title}</h1>
        </div>

        <p class="case__deck">{project.tagline}</p>
      </div>

      <!-- Run sheet: the metadata as a production band rather than a list. -->
      <div class="case__runsheet">
        <div class="shell">
          <div class="ticks" aria-hidden="true"></div>
          <dl class="run">
            {
              project.spec.map((item) => (
                <div class="run__cell">
                  <dt>{item.key}</dt>
                  <dd>{item.val}</dd>
                </div>
              ))
            }
          </dl>
          <div class="ticks ticks--flip" aria-hidden="true"></div>
        </div>
      </div>
    </header>

    <div class="shell case__visual">
      <div class="exhibit">
        <div class="exhibit__object">
          <ProjectVisual visual={project.visual} />
        </div>

        {
          project.notes && (
            <ol class="exhibit__notes">
              {project.notes.map((note, i) => (
                <li class="exhibit__note">
                  <span class="exhibit__pin" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="exhibit__body">
                    <b>{note.k}</b>
                    {note.v}
                  </span>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </div>

    <div class="case__main shell shell--narrow">
      {
        sections.length > 0 && (
          <nav class="toc" aria-label="Sections">
            <p class="toc__label">Contents</p>
            <ol class="toc__list">
              {sections.map((section, i) => (
                <li>
                  <a href={`#${section.id}`} class="toc__link" data-toc={section.id}>
                    <span class="toc__n">{String(i + 1).padStart(2, '0')}</span>
                    <span>{section.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="case__body rich">
        <slot />
      </div>
    </div>
  </article>

  <nav class="case__next" aria-label="Next project">
    <div class="shell shell--narrow">
      <a href={next.href} class="case__next-link">
        <span class="label">Next</span>
        <span class="case__next-title">{next.title}</span>
        <span class="case__next-tag">{next.tagline}</span>
        <span class="case__next-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <div class="case__cta">
        <p class="case__cta-text">
          Building something where this kind of thinking is the hard part?
        </p>
        <a class="btn btn--primary" href={mailto(`About ${project.title}`)}>
          Get in touch <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </nav>

  <script is:inline>
    // Marks the section you are currently reading in the contents rail.
    // Pure enhancement: the entries are ordinary anchors and work without it.
    (() => {
      const links = document.querySelectorAll('[data-toc]');
      if (!links.length || !('IntersectionObserver' in window)) return;

      const byId = new Map([...links].map((a) => [a.dataset.toc, a]));
      const visible = new Map();

      const paint = () => {
        let current = null;
        for (const [id, on] of visible) {
          if (on) {
            current = id;
            break;
          }
        }
        if (!current) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        byId.get(current)?.setAttribute('aria-current', 'true');
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
          paint();
        },
        { rootMargin: '-12% 0px -72% 0px' }
      );

      // Seeded in document order, so "first visible" is also "topmost".
      byId.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) {
          visible.set(id, false);
          io.observe(el);
        }
      });
    })();
  </script>
</Base>

<style>
  .case__header {
    padding-top: clamp(1.25rem, 0.5rem + 3vw, 2.75rem);
  }

  .case__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .case__title-block {
    margin-top: clamp(1rem, 0.4rem + 2.4vw, 2.5rem);
  }

  .case__index {
    display: block;
    font-size: var(--step-6);
    margin-bottom: 0.1em;
  }

  @media (min-width: 62em) {
    /* The number sits behind the title's shoulder rather than above it. */
    .case__title-block {
      display: grid;
      grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
      gap: var(--space-l);
      align-items: start;
    }

    .case__index {
      font-size: var(--step-7);
      margin: -0.06em 0 0 -0.06em;
    }
  }

  /* --- run sheet ----------------------------------------------------- */
  .case__runsheet {
    margin-top: clamp(1.75rem, 1rem + 3vw, 3.25rem);
  }

  .ticks--flip {
    transform: scaleY(-1);
  }

  .run {
    display: grid;
    gap: 0;
    padding-block: var(--space-s);
  }

  .run__cell {
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--rule);
  }

  .run__cell:last-child {
    border-bottom: 0;
  }

  .run__cell dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .run__cell dd {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink);
  }

  @media (min-width: 46em) {
    .run {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-l);
      padding-block: var(--space-m);
    }

    .run__cell {
      padding-block: 0;
      border-bottom: 0;
      border-left: 1px solid var(--rule);
      padding-left: var(--space-m);
    }

    .run__cell:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }

  .case__back:hover {
    color: var(--accent-ink);
  }

  .case__title {
    font-size: var(--step-6);
    letter-spacing: -0.04em;
    line-height: 0.93;
    max-width: 13ch;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .case__deck {
    margin-top: var(--space-m);
    font-family: var(--font-prose);
    font-size: var(--step-3);
    line-height: 1.2;
    letter-spacing: -0.018em;
    color: var(--ink-2);
    max-width: 24ch;
    text-wrap: pretty;
  }

  @media (min-width: 62em) {
    .case__deck {
      margin-left: calc(10rem + var(--space-l));
      max-width: 30ch;
    }
  }

  .case__visual {
    margin-block: var(--space-xl);
  }

  /* --- exhibit: the interface, with the thinking pinned beside it ----- */
  .exhibit {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 62em) {
    .exhibit {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .exhibit__object {
    min-width: 0;
  }

  .exhibit__notes {
    display: grid;
    border-top: 1px solid var(--rule-strong);
  }

  @media (min-width: 62em) {
    .exhibit__notes {
      margin-top: var(--space-l);
    }
  }

  .exhibit__note {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--rule);
  }

  .exhibit__pin {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
  }

  .exhibit__body b {
    display: block;
    font-size: var(--step-0);
    font-weight: 620;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin-bottom: 0.15rem;
  }

  .exhibit__body {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .case__body {
    padding-bottom: var(--space-2xl);
    min-width: 0;
  }

  /* --------------------------------------------------- contents rail ---
     Only appears where there is genuinely spare margin. Below that width
     the document is short enough to scroll, and the rail would just be
     another thing between the reader and the writing. */
  .toc {
    display: none;
  }

  @media (min-width: 78em) {
    .case__main {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 11rem;
      gap: var(--space-2xl);
      align-items: start;
      max-width: 68rem;
    }

    .toc {
      display: block;
      position: sticky;
      top: 6rem;
      order: 2;
      padding-left: var(--space-m);
      border-left: 1px solid var(--rule);
    }
  }

  .toc__label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-2xs);
  }

  .toc__list {
    display: grid;
    gap: 0.1rem;
  }

  .toc__link {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 0.35rem;
    align-items: baseline;
    padding-block: 0.32rem;
    font-size: var(--step--1);
    line-height: 1.3;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.18s var(--ease);
  }

  .toc__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .toc__link:hover {
    color: var(--ink);
  }

  .toc__link[aria-current='true'] {
    color: var(--ink);
    font-weight: 560;
  }

  .toc__link[aria-current='true'] .toc__n {
    color: var(--accent-ink);
  }

  /* ---------------------------------------------------------- next --- */
  .case__next {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-xl);
    background: color-mix(in srgb, var(--paper-sunken) 55%, transparent);
  }

  .case__next-link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label arrow'
      'title arrow'
      'tag   arrow';
    align-items: center;
    gap: 0.3rem var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    text-decoration: none;
    transition:
      border-color 0.22s var(--ease),
      box-shadow 0.28s var(--ease),
      transform 0.28s var(--ease-out);
  }

  @media (hover: hover) {
    .case__next-link:hover {
      border-color: var(--rule-strong);
      box-shadow: var(--shadow-card);
      transform: translateY(-2px);
    }
  }

  .case__next-link > :global(.label) {
    grid-area: label;
  }

  .case__next-title {
    grid-area: title;
    font-size: var(--step-2);
    font-weight: 620;
    letter-spacing: -0.024em;
    line-height: 1.1;
  }

  .case__next-tag {
    grid-area: tag;
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.45;
    max-width: 44ch;
  }

  .case__next-arrow {
    grid-area: arrow;
    font-size: var(--step-2);
    color: var(--accent-ink);
    transition: transform 0.28s var(--ease-out);
  }

  @media (hover: hover) {
    .case__next-link:hover .case__next-arrow {
      transform: translateX(5px);
    }
  }

  .case__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .case__cta-text {
    font-family: var(--font-prose);
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 34ch;
    line-height: 1.4;
  }
</style>
