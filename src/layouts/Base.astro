---
import '../styles/global.css';
import '../styles/print.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Pass false on the homepage so the title isn't "Cameron Macek — Cameron Macek". */
  suffix?: boolean;
  ogType?: 'website' | 'article';
  /** Per-page social card in public/. Falls back to the site-wide one. */
  ogImage?: string;
}

const { title, description, suffix = true, ogType = 'website', ogImage = '/og.png' } = Astro.props;

const pageTitle = suffix ? `${title} — ${site.name}` : title;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Operations & AI Implementation',
  description: site.description,
  address: { '@type': 'PostalAddress', addressRegion: 'Indiana', addressCountry: 'US' },
  knowsAbout: [
    'Restaurant operations',
    'AI implementation',
    'Internal tools',
    'Workflow automation',
    'Standard operating procedures',
    'Product operations',
  ],
  ...(site.profiles.some((p) => p.url) && { sameAs: site.profiles.filter((p) => p.url).map((p) => p.url) }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Gates the scroll-reveal styles. Runs before first paint, so the page
         never flashes; without JS the reveal CSS simply never applies. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f4f1e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13110e" media="(prefers-color-scheme: dark)" />

    <!-- The headline and lede paint in these two; preload beats the CSS round-trip. -->
    <link
      rel="preload"
      href="/fonts/archivo-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — operations and AI implementation`} />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Only ever seen on paper: gives a printed or PDF'd page a masthead
         with the contact details, since the site chrome is stripped. -->
    <header class="print-masthead" aria-hidden="true">
      <div class="print-masthead__name">{site.name}</div>
      <div class="print-masthead__meta">
        <span>Operations &amp; AI implementation</span><span>{site.location}</span><span
          >{site.email}</span
        ><span>{site.url.replace('https://', '')}</span>
      </div>
    </header>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <p class="print-source" aria-hidden="true">{canonical}</p>
    <Footer />

    <script is:inline>
      // Progressive scroll reveal. Nothing depends on it — content is visible
      // without JS, and reduced-motion users never see it run.
      (() => {
        const items = document.querySelectorAll('[data-reveal]');
        if (!items.length) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
