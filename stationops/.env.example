# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection string. Works with Supabase (use the "Session pooler"
# connection string), Neon, Render, or any PostgreSQL 14+ server.
DATABASE_URL=postgres://stationops:localdev@localhost:5432/stationops

# Set to "require" when your provider requires TLS (Supabase, Neon, Render).
DATABASE_SSL=

# Only used by `npm run db:seed-demo`. Leave blank to have the script generate
# random passwords and print them once.
DEMO_MANAGER_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
